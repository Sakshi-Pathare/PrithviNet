# PrithviNet Database & Configuration
# ------------------------------------
# To connect to Supabase:
# 1. Open your Supabase Dashboard: https://supabase.com/dashboard
# 2. Go to Project Settings -> Database
# 3. Copy your Connection String (URI) from the 'Connection pooling' or 'Direct connection' tab:
#
# DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[your-region].pooler.supabase.com:6543/postgres?sslmode=require
#
# If no DATABASE_URL is provided, PrithviNet defaults to local SQLite.
DATABASE_URL=sqlite:///backend/prithvinet.db

# JWT Secret Key for user session authentication
JWT_SECRET=prithvinet-pune-green-secret-key-2026

# Optional Mapbox access token for community map
MAPBOX_ACCESS_TOKEN=

